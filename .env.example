# Every variable is optional: the defaults below are what the app uses when unset.

# --- Backend (FastAPI) -------------------------------------------------------
# Read from the shell environment when starting uvicorn.
# Product catalog and tier rules (relative paths resolve from the backend/ directory).
DEAL_DESK_CATALOG_PATH=../data/catalog.json
# JSON file where saved quotes are persisted. Created on first save.
DEAL_DESK_QUOTES_PATH=var/quotes.json
# Comma-separated browser origins allowed to call the API.
DEAL_DESK_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Shared passcode that unlocks approve/reject (the Approvals pages). Change it outside local demos.
DEAL_DESK_ADMIN_PASSCODE=approver

# --- Frontend (Next.js) ------------------------------------------------------
# Put this in frontend/.env.local. Base URL of the Python API as seen from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
